generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id                                        String                                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                   String?                                     @db.Uuid
  name                                      String                                      @db.VarChar(100)
  type                                      transaction_type
  color                                     String?                                     @db.VarChar(7)
  icon                                      String?                                     @db.VarChar(100)
  is_system                                 Boolean                                     @default(false)
  created_at                                DateTime                                    @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                                    @default(now()) @db.Timestamptz(6)
  users                                     users?                                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction_templates                     transaction_templates[]
  transactions                              transactions[]
  dashboard_hidden_categories               dashboard_hidden_categories[]
  spending_budget_categories                spending_budget_categories[]
  spending_plan_revision_purpose_categories spending_plan_revision_purpose_categories[]

  @@unique([user_id, name, type], map: "uq_category_user_name")
  @@index([user_id, type], map: "idx_categories_type")
  @@index([user_id], map: "idx_categories_user")
}

model spending_budgets {
  id                         String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                    String                       @db.Uuid
  name                       String                       @db.VarChar(100)
  amount                     Decimal                      @db.Decimal(20, 2)
  period                     spending_budget_period
  wallet_scope               spending_budget_wallet_scope @default(all)
  includes_uncategorized     Boolean                      @default(false)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  users                      users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spending_budget_categories spending_budget_categories[]
  spending_budget_wallets    spending_budget_wallets[]

  @@index([user_id, is_active, period], map: "idx_spending_budgets_user_active_period")
}

model spending_budget_wallets {
  budget_id        String           @db.Uuid
  wallet_id        String           @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  spending_budgets spending_budgets @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallets          wallets          @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)

  @@id([budget_id, wallet_id])
  @@index([wallet_id], map: "idx_spending_budget_wallets_wallet_id")
}

model spending_budget_categories {
  budget_id        String           @db.Uuid
  category_id      String           @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  spending_budgets spending_budgets @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories       categories       @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([budget_id, category_id])
  @@index([category_id], map: "idx_spending_budget_categories_category_id")
}

model spending_plans {
  id                             String                          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                        String                          @db.Uuid
  name                           String                          @db.VarChar(100)
  amount                         Decimal                         @db.Decimal(20, 2)
  start_date                     DateTime                        @db.Date
  end_date                       DateTime                        @db.Date
  cancelled_at                   DateTime?                       @db.Timestamptz(6)
  created_at                     DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                        @default(now()) @db.Timestamptz(6)
  users                          users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spending_plan_revisions        spending_plan_revisions[]
  spending_plan_view_preferences spending_plan_view_preferences?

  @@index([user_id, start_date, end_date], map: "idx_spending_plans_user_dates")
  @@index([user_id, cancelled_at], map: "idx_spending_plans_user_cancelled")
}

model spending_plan_revisions {
  id                              String                            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  plan_id                         String                            @db.Uuid
  effective_date                  DateTime                          @db.Date
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  spending_plans                  spending_plans                    @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spending_plan_revision_wallets  spending_plan_revision_wallets[]
  spending_plan_revision_purposes spending_plan_revision_purposes[]

  @@index([plan_id, effective_date(sort: Desc), created_at(sort: Desc)], map: "idx_spending_plan_revisions_plan_date")
  @@unique([plan_id, effective_date], map: "uq_spending_plan_revisions_plan_effective_date")
}

model spending_plan_revision_wallets {
  revision_id             String                  @db.Uuid
  wallet_id               String                  @db.Uuid
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  spending_plan_revisions spending_plan_revisions @relation(fields: [revision_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallets                 wallets                 @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([revision_id, wallet_id])
  @@index([wallet_id], map: "idx_spending_plan_revision_wallets_wallet")
}

model spending_plan_revision_purposes {
  id                                        String                                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  revision_id                               String                                      @db.Uuid
  name                                      String                                      @db.VarChar(100)
  sort_order                                Int
  target_amount                             Decimal?                                    @db.Decimal(20, 2)
  distribution_type                         spending_plan_distribution_type?
  distribution_weekdays                     Int[]                                      @default([])
  spending_plan_revisions                   spending_plan_revisions                     @relation(fields: [revision_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spending_plan_revision_purpose_categories spending_plan_revision_purpose_categories[]
  spending_plan_revision_allocations        spending_plan_revision_allocations[]
  spending_plan_revision_purpose_dates      spending_plan_revision_purpose_dates[]

  @@unique([revision_id, name], map: "uq_spending_plan_revision_purpose_name")
  @@index([revision_id, sort_order], map: "idx_spending_plan_revision_purposes_order")
}

model spending_plan_revision_purpose_categories {
  purpose_id                      String                          @db.Uuid
  category_id                     String                          @db.Uuid
  created_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  spending_plan_revision_purposes spending_plan_revision_purposes @relation(fields: [purpose_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories                      categories                      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([purpose_id, category_id])
  @@index([category_id], map: "idx_spending_plan_purpose_categories_category")
}

model spending_plan_revision_allocations {
  purpose_id                      String                          @db.Uuid
  allocation_date                 DateTime                        @db.Date
  amount                          Decimal                         @db.Decimal(20, 2)
  created_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  spending_plan_revision_purposes spending_plan_revision_purposes @relation(fields: [purpose_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([purpose_id, allocation_date])
  @@index([allocation_date], map: "idx_spending_plan_allocations_date")
}

model spending_plan_revision_purpose_dates {
  purpose_id                      String                          @db.Uuid
  selected_date                   DateTime                        @db.Date
  spending_plan_revision_purposes spending_plan_revision_purposes @relation(fields: [purpose_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([purpose_id, selected_date])
  @@index([selected_date], map: "idx_spending_plan_purpose_dates_date")
}

model spending_plan_view_preferences {
  plan_id               String             @id @db.Uuid
  last_view             spending_plan_view @default(monthly)
  show_daily_balance    Boolean            @default(true)
  visible_purpose_names String[]           @default(dbgenerated("(ARRAY[]::character varying[])::character varying(100)[]")) @db.VarChar(100)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  spending_plans        spending_plans     @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model dashboard_preferences {
  user_id                       String                        @id @db.Uuid
  period_start                  DateTime                      @db.Date
  period_end                    DateTime                      @db.Date
  is_category_breakdown_enabled Boolean                       @default(false)
  created_at                    DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime                      @default(now()) @db.Timestamptz(6)
  users                         users                         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dashboard_hidden_categories   dashboard_hidden_categories[]
}

model dashboard_hidden_categories {
  user_id               String                @db.Uuid
  category_id           String                @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  dashboard_preferences dashboard_preferences @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  categories            categories            @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, category_id])
  @@index([category_id], map: "idx_dashboard_hidden_categories_category_id")
}

model dashboard_wallet_summary_preferences {
  user_id                          String                             @id @db.Uuid
  is_configured                    Boolean                            @default(false)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  users                            users                              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dashboard_wallet_summary_wallets dashboard_wallet_summary_wallets[]
}

model dashboard_wallet_summary_wallets {
  user_id                              String                               @db.Uuid
  wallet_id                            String                               @db.Uuid
  created_at                           DateTime                             @default(now()) @db.Timestamptz(6)
  dashboard_wallet_summary_preferences dashboard_wallet_summary_preferences @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  wallets                              wallets                              @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, wallet_id])
  @@index([wallet_id], map: "idx_dashboard_wallet_summary_wallets_wallet_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model refresh_tokens {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  is_revoked Boolean  @default(false)
  ip_address String?  @db.Inet
  user_agent String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transaction_templates {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String           @db.Uuid
  wallet_id      String?          @db.Uuid
  category_id    String?          @db.Uuid
  name           String           @db.VarChar(150)
  type           transaction_type
  default_amount Decimal?         @db.Decimal(20, 2)
  note           String?
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  categories     categories?      @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallets        wallets?         @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)
  transactions   transactions[]

  @@unique([user_id, name, type], map: "uq_transaction_templates_user_name_type")
  @@index([user_id, is_active, type], map: "idx_transaction_templates_user_active_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model transactions {
  id                                                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  wallet_id                                             String                 @db.Uuid
  category_id                                           String?                @db.Uuid
  template_id                                           String?                @db.Uuid
  name                                                  String                 @db.VarChar(255)
  type                                                  transaction_type
  amount                                                Decimal                @db.Decimal(20, 2)
  note                                                  String?
  transaction_date                                      DateTime               @db.Date
  metadata                                              Json?
  created_at                                            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                            DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                                            DateTime?              @db.Timestamptz(6)
  categories                                            categories?            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  transaction_templates                                 transaction_templates? @relation(fields: [template_id], references: [id], onUpdate: NoAction)
  wallets                                               wallets                @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)
  transfers_transfers_from_transaction_idTotransactions transfers?             @relation("transfers_from_transaction_idTotransactions")
  transfers_transfers_to_transaction_idTotransactions   transfers?             @relation("transfers_to_transaction_idTotransactions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transfers {
  id                                                       String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  allocation_id                                            String?            @db.Uuid
  from_wallet_id                                           String             @db.Uuid
  to_wallet_id                                             String             @db.Uuid
  from_transaction_id                                      String?            @unique @db.Uuid
  to_transaction_id                                        String?            @unique @db.Uuid
  amount                                                   Decimal            @db.Decimal(20, 2)
  fee                                                      Decimal            @default(0.00) @db.Decimal(20, 2)
  note                                                     String?
  transfer_date                                            DateTime           @db.Date
  created_at                                               DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                               DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at                                               DateTime?          @db.Timestamptz(6)
  money_allocations                                        money_allocations? @relation(fields: [allocation_id], references: [id], onUpdate: NoAction)
  transactions_transfers_from_transaction_idTotransactions transactions?      @relation("transfers_from_transaction_idTotransactions", fields: [from_transaction_id], references: [id], onUpdate: NoAction)
  wallets_transfers_from_wallet_idTowallets                wallets            @relation("transfers_from_wallet_idTowallets", fields: [from_wallet_id], references: [id], onUpdate: NoAction)
  transactions_transfers_to_transaction_idTotransactions   transactions?      @relation("transfers_to_transaction_idTotransactions", fields: [to_transaction_id], references: [id], onUpdate: NoAction)
  wallets_transfers_to_wallet_idTowallets                  wallets            @relation("transfers_to_wallet_idTowallets", fields: [to_wallet_id], references: [id], onUpdate: NoAction)

  @@index([transfer_date(sort: Desc)], map: "idx_transfers_date")
  @@index([deleted_at], map: "idx_transfers_deleted_at")
  @@index([from_wallet_id, transfer_date(sort: Desc)], map: "idx_transfers_from_wallet")
  @@index([to_wallet_id, transfer_date(sort: Desc)], map: "idx_transfers_to_wallet")
  @@index([allocation_id], map: "idx_transfers_allocation")
}

model money_allocations {
  id                                                  String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                             String      @db.Uuid
  source_wallet_id                                    String      @db.Uuid
  amount                                              Decimal     @db.Decimal(20, 2)
  allocation_date                                     DateTime    @db.Date
  note                                                String?
  created_at                                          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                                          DateTime    @default(now()) @db.Timestamptz(6)
  deleted_at                                          DateTime?   @db.Timestamptz(6)
  users                                               users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wallets_money_allocations_source_wallet_idTowallets wallets     @relation("money_allocations_source_wallet_idTowallets", fields: [source_wallet_id], references: [id], onUpdate: NoAction)
  transfers                                           transfers[]

  @@index([user_id, deleted_at, allocation_date(sort: Desc)], map: "idx_money_allocations_user_date")
  @@index([source_wallet_id], map: "idx_money_allocations_source_wallet")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                   String                                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                                String                                @unique @db.VarChar(255)
  password_hash                        String                                @db.VarChar(255)
  full_name                            String                                @db.VarChar(150)
  avatar_url                           String?                               @db.VarChar(500)
  avatar_path                          String?                               @db.VarChar(500)
  role                                 user_role                             @default(user)
  is_active                            Boolean                               @default(true)
  session_version                      Int                                   @default(0)
  email_verified_at                    DateTime?                             @db.Timestamptz(6)
  created_at                           DateTime                              @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime                              @default(now()) @db.Timestamptz(6)
  deleted_at                           DateTime?                             @db.Timestamptz(6)
  categories                           categories[]
  dashboard_preferences                dashboard_preferences?
  dashboard_wallet_summary_preferences dashboard_wallet_summary_preferences?
  refresh_tokens                       refresh_tokens[]
  transaction_templates                transaction_templates[]
  money_allocations                    money_allocations[]
  spending_budgets                     spending_budgets[]
  spending_plans                       spending_plans[]
  wallets                              wallets[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model wallets {
  id                                                            String                             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                                       String                             @db.Uuid
  parent_wallet_id                                              String?                            @db.Uuid
  name                                                          String                             @db.VarChar(150)
  description                                                   String?
  wallet_type                                                   wallet_type                        @default(normal)
  balance                                                       Decimal                            @default(0.00) @db.Decimal(20, 2)
  currency                                                      String                             @default("THB") @db.Char(3)
  color                                                         String?                            @db.VarChar(7)
  icon                                                          String?                            @db.VarChar(100)
  sort_order                                                    Int                                @default(0)
  is_active                                                     Boolean                            @default(true)
  created_at                                                    DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                                                    DateTime                           @default(now()) @db.Timestamptz(6)
  deleted_at                                                    DateTime?                          @db.Timestamptz(6)
  transaction_templates                                         transaction_templates[]
  transactions                                                  transactions[]
  transfers_transfers_from_wallet_idTowallets                   transfers[]                        @relation("transfers_from_wallet_idTowallets")
  transfers_transfers_to_wallet_idTowallets                     transfers[]                        @relation("transfers_to_wallet_idTowallets")
  money_allocations_money_allocations_source_wallet_idTowallets money_allocations[]                @relation("money_allocations_source_wallet_idTowallets")
  dashboard_wallet_summary_wallets                              dashboard_wallet_summary_wallets[]
  spending_budget_wallets                                       spending_budget_wallets[]
  spending_plan_revision_wallets                                spending_plan_revision_wallets[]
  wallets                                                       wallets?                           @relation("walletsTowallets", fields: [parent_wallet_id], references: [id], onUpdate: NoAction)
  other_wallets                                                 wallets[]                          @relation("walletsTowallets")
  users                                                         users                              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum transaction_type {
  income
  expense
}

enum spending_budget_period {
  daily
  weekly
  monthly
  yearly
}

enum spending_budget_wallet_scope {
  all
  selected
}

enum spending_plan_view {
  monthly
  range
  daily
}

enum spending_plan_distribution_type {
  equal_daily
  weekdays
  weekly
  biweekly
  specific_dates
}

enum user_role {
  admin
  user
}

enum wallet_type {
  normal
  investment
}
